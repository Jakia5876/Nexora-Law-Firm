# =============================================================================
# Nexora Law Firm — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public API key (found in Project Settings → API)
# This key is safe to use in client-side code — RLS policies protect your data.
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Your Supabase service role key (SERVER-SIDE ONLY — never expose in browser)
# Used only for admin scripts or server functions, not in HTML files.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Environment: development | staging | production
APP_ENV=development

# Application base URL (used for redirects and canonical links)
APP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional — for future notification features)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@nexoralaw.com

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION (Supabase Storage is used by default)
# -----------------------------------------------------------------------------
# Supabase Storage bucket name for case documents
STORAGE_BUCKET=case-documents

# =============================================================================
# HOW TO USE IN THIS PROJECT
# =============================================================================
# Since Nexora Law Firm is a static HTML project (no build step), environment
# variables are NOT automatically injected at runtime.
#
# For local development:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your Supabase URL and anon key
# 3. Manually update the inline JS constants in index.html and cases.html:
#
#    const SUPABASE_URL = 'https://your-project-id.supabase.co';
#    const SUPABASE_ANON_KEY = 'your-supabase-anon-key-here';
#
# For Vercel deployment:
# Add SUPABASE_URL and SUPABASE_ANON_KEY in the Vercel dashboard under
# Project Settings → Environment Variables.
# =============================================================================
