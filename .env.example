# ==============================================================================
# NEXORA LAW FIRM — NEXT.JS ENVIRONMENT TEMPLATE
# Single canonical configuration template for Next.js App Router & Docker
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local before running the Next.js development server:
#    cp .env.example .env.local
# 2. Supply your real Supabase project credentials in your deployment dashboard.
# 3. All NEXT_PUBLIC_* variables are exposed to client-side components.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE PUBLIC CREDENTIALS (Client-Side & Server-Side Accessible)
# ------------------------------------------------------------------------------
# The HTTPS URL of your Supabase project instance (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The Supabase anonymous/public API key (used for client-side queries and public consultation intake)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# SUPABASE SERVICE ROLE KEY (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Privileged service role secret key used in Server Actions and API route mutations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC SESSION SECURITY (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# High-entropy secret key used to sign and verify administrative JWT session tokens (HMAC SHA-256)
SESSION_SECRET= # generate with: openssl rand -base64 32

# ------------------------------------------------------------------------------
# APPLICATION & SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Application runtime environment mode (development, staging, production)
NODE_ENV=development

# Fully qualified base canonical URL of the deployed application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server listening port for Next.js production server and container
PORT=3000

# ------------------------------------------------------------------------------
# CLOUD STORAGE BUCKET
# ------------------------------------------------------------------------------
# Supabase Storage bucket name for client document vaults and court pleadings
NEXT_PUBLIC_STORAGE_BUCKET=case-documents

# ------------------------------------------------------------------------------
# ADMINISTRATOR ACCESS (SERVER-SIDE ONLY — NO CLIENT EXPOSURE)
# ------------------------------------------------------------------------------
# Administrator email verified server-side during session authentication
ADMIN_EMAIL=admin@example.com

# Initial administrator password placeholder (must be set per deployment; rotated upon first login)
ADMIN_DEFAULT_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE

# ------------------------------------------------------------------------------
# FIRM BRANDING & CONTACT SETTINGS
# ------------------------------------------------------------------------------
# Corporate legal entity name
FIRM_NAME="Nexora Law Firm"

# Firm public telephone number
FIRM_PHONE="+1-800-555-0199"

# Firm intake email address
FIRM_EMAIL="contact@nexoralaw.com"

# Physical office headquarters
FIRM_OFFICE_ADDRESS="742 Evergreen Terrace, Suite 500, New York, NY 10001"

# ------------------------------------------------------------------------------
# EMAIL / NOTIFICATION SERVICE NOTE
# ------------------------------------------------------------------------------
# Note: Direct transactional SMTP email is not utilized in this version; client inquiries
# are persisted directly into the Supabase 'contacts' table via isolated anon INSERT.
# If integrating an external provider (e.g. Resend or SendGrid), supply keys here:
# RESEND_API_KEY=re_your_api_key_here
