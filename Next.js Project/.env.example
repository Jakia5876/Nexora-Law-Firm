# ==============================================================================
# NEXORA LAW FIRM — NEXT.JS ENVIRONMENT TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local before running the Next.js development server:
#    cp .env.example .env.local
# 2. Supply your real Supabase project credentials in your deployment dashboard.
# 3. All NEXT_PUBLIC_* variables are exposed to client-side components.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE PUBLIC CREDENTIALS (Client-Side & Server-Side Accessible)
# ------------------------------------------------------------------------------
# The HTTPS URL of your Supabase project instance (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The Supabase anonymous/public API key (used for client-side queries and public consultation intake)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# SUPABASE SERVICE ROLE KEY (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Privileged service role secret key used in Server Actions and API route mutations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# APPLICATION & SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Application runtime environment mode (development, staging, production)
NODE_ENV=development

# Fully qualified base canonical URL of the deployed application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server listening port for Next.js production server
PORT=3000

# ------------------------------------------------------------------------------
# CLOUD STORAGE BUCKET
# ------------------------------------------------------------------------------
# Supabase Storage bucket name for client document vaults and court pleadings
NEXT_PUBLIC_STORAGE_BUCKET=case-documents

# ------------------------------------------------------------------------------
# DEMO & INITIAL ADMINISTRATOR ACCESS
# ------------------------------------------------------------------------------
# Default administrator login email used for role-gated admin verification
NEXT_PUBLIC_ADMIN_EMAIL=admin@nexoralaw.com

# Default initial administrator password placeholder for first login
ADMIN_DEFAULT_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
