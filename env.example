# ==============================================================================
# NEXORA LAW FIRM — CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env before starting your server or container:
#    cp .env.example .env
# 2. Replace all placeholder values with your specific configuration.
# 3. NEVER commit your actual .env file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
# The HTTPS URL of your Supabase project instance (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# The Supabase anonymous/public API key (safe for browser client-side operations; protected by RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# The Supabase service role API key (SERVER-SIDE ONLY - grants full administrative bypass of RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# APPLICATION RUNTIME & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment mode (options: development, staging, production)
APP_ENV=development

# Fully qualified base URL of the client application (used for redirects, invitations, and canonical links)
APP_URL=http://localhost:8080

# The local or container port on which the web server listens
PORT=8080

# Cross-Origin Resource Sharing (CORS) allowed origin for API requests
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# CLOUD STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase Storage bucket name used for private case files, pleadings, and client document vaults
STORAGE_BUCKET=case-documents

# Maximum allowed upload file size for legal documents (in bytes, default: 26214400 for 25MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# ------------------------------------------------------------------------------
# INITIAL ADMINISTRATOR SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Default administrator email address used during initial database seeding
ADMIN_DEFAULT_EMAIL=admin@nexoralaw.com

# Default initial administrator password (must be changed upon first login)
ADMIN_DEFAULT_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD

# Default administrator full legal name
ADMIN_DEFAULT_NAME=Chief Managing Partner

# Default administrator primary phone number
ADMIN_DEFAULT_PHONE=+1-800-555-0199

# ------------------------------------------------------------------------------
# SMTP / EMAIL NOTIFICATION SETTINGS (Optional - for consultation email alerts)
# ------------------------------------------------------------------------------
# SMTP mail server hostname
SMTP_HOST=smtp.mailtrap.io

# SMTP mail server port (typically 587 for TLS, 465 for SSL, or 2525)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=your-smtp-username-here

# SMTP authentication password
SMTP_PASS=your-smtp-password-here

# Sender email address displayed on outgoing notifications and case updates
SMTP_FROM_EMAIL=notifications@nexoralaw.com

# Sender name displayed on outgoing emails
SMTP_FROM_NAME=Nexora Law Firm Intake

# ------------------------------------------------------------------------------
# BRANDING & FIRM CUSTOMIZATION CONFIGURATION
# ------------------------------------------------------------------------------
# Legal firm corporate name displayed on portal and documents
FIRM_NAME=Nexora Law Firm

# Primary firm business contact phone number displayed across public web pages
FIRM_PHONE=+1-800-555-0199

# Primary public contact email address for general consultations
FIRM_EMAIL=contact@nexoralaw.com

# Firm physical headquarters office address
FIRM_OFFICE_ADDRESS=742 Evergreen Terrace, Suite 500, New York, NY 10001
